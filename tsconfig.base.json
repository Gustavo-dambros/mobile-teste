{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@unipar/types": ["./packages/shared/types/src"],
      "@unipar/types/*": ["./packages/shared/types/src/*"],
      "@unipar/utils": ["./packages/shared/utils/src"],
      "@unipar/utils/*": ["./packages/shared/utils/src/*"],
      "@unipar/constants": ["./packages/shared/constants/src"],
      "@unipar/constants/*": ["./packages/shared/constants/src/*"],
      "@unipar/api": ["./packages/api/src"],
      "@unipar/api/*": ["./packages/api/src/*"],
      "@unipar/validation": ["./packages/shared/validation/src"],
      "@unipar/validation/*": ["./packages/shared/validation/src/*"]
    }
  }
}
