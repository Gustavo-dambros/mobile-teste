# Configuração de ambiente do app mobile (Expo).
# Copie este arquivo para `.env` e preencha os valores reais.
# OBS: `EXPO_PUBLIC_*` são embutidas em tempo de build (dev, export e EAS Build).

# --- Supabase (auth provider / sessão) ---
# URL do projeto Supabase (Settings > API).
EXPO_PUBLIC_SUPABASE_URL=
# Chave anon/publishable do Supabase (não é secreta — vai no bundle do app).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend Unipar (API REST sob /api/*, aceita Bearer JWT do Supabase) ---
# IMPORTANTE para APK/device físico: NÃO use localhost (aponta para o próprio celular).
# Use o IP da máquina na rede local, ex.: http://192.168.0.10:3000.
# Para emulador Android (adb reverse já configurado) localhost pode funcionar.
EXPO_PUBLIC_API_URL=

# --- EAS Build ---
# As mesmas variáveis acima são declaradas no bloco "env" de cada perfil em mobile/eas.json
# (preview/production). Prefira editá-las lá para builds na nuvem (eas build --profile ...).
# Para builds locais via EAS (--local), este .env é lido automaticamente.
