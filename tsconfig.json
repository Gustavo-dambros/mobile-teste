{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@unipar/types": ["./packages/shared/types/src"],
      "@unipar/types/*": ["./packages/shared/types/src/*"],
      "@unipar/utils": ["./packages/shared/utils/src"],
      "@unipar/utils/*": ["./packages/shared/utils/src/*"],
      "@unipar/constants": ["./packages/shared/constants/src"],
      "@unipar/constants/*": ["./packages/shared/constants/src/*"],
      "@unipar/api": ["./packages/api/src"],
      "@unipar/api/*": ["./packages/api/src/*"],
      "@unipar/validation": ["./packages/shared/validation/src"],
      "@unipar/validation/*": ["./packages/shared/validation/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
